{
  "classification": {
    "value": "A | B | C | D",
    "required": true,
    "vocabulary": ["STRICTLY CONFIDENTIAL", "CONFIDENTIAL", "SENSITIVE", "PUBLIC", "OPEN", "NON-SENSITIVE", "UNRESTRICTED"]
  },

  "document_reference": {
    "pattern": "YYYY-XXX-spec",
    "required": true
  },

  "title_page": {
    "primary_title": { "type": "string", "required": true },
    "document_class": { "type": "string", "required": true },
    "technical_version": { "type": "string", "pattern": "v[0-9]+\\.[0-9]+", "required": true },
    "spec_type": { "type": "string", "default": "Governance & Architecture Specification" },
    "author": { "type": "string", "required": true },
    "date": { "type": "string", "format": "YYYY-MM-DD", "required": true },
    "status": {
      "type": "string",
      "enum": ["Draft", "Stable", "Deprecated"],
      "required": true
    },
    "scope_short": { "type": "string", "required": true },
    "primary_model": { "type": "string", "required": true }
  },

  "scope": {
    "description": "Defines applicability across Classes A–D",
    "applies_to": ["A", "B", "C", "D"],
    "exclusions": ["Documents outside governed corpus"]
  },

  "model_scheme": {
    "name": "SC-TPGM",
    "layers": [
      "Classification Layer",
      "Semantic Title Layer",
      "Metadata Layer",
      "Visual Hierarchy Layer",
      "Security Reinforcement Layer"
    ]
  },

  "typography": {
    "fonts_allowed": {
      "sans_serif": ["Arial", "Helvetica", "Calibri"],
      "serif": ["Times New Roman", "Garamond"]
    },
    "sizes": {
      "classification_marker": "14pt+ bold uppercase",
      "main_title": "16-18pt bold",
      "subtitle": "14-16pt",
      "metadata": "12pt"
    },
    "margins": "1in / 2.54cm",
    "line_spacing": {
      "title_block": "double",
      "metadata_block": "1.15-1.5"
    },
    "banners": {
      "class_A_top": true,
      "class_A_bottom": true,
      "banner_height_cm": "0.6-1.0"
    }
  },

  "semantic_line_breaks": {
    "required": true,
    "rules": [
      "Break at conceptual boundaries",
      "Do not break mid-phrase"
    ]
  },

  "layout_schema": {
    "structure": [
      "classification_marker_top",
      "document_reference",
      "title_block",
      "metadata_block",
      "status",
      "scope_short",
      "primary_model",
      "confidentiality_notice (A/B/C only)",
      "classification_marker_bottom (A only)"
    ]
  },

  "classification_classes": {
    "A": {
      "name": "Strictly Confidential",
      "signals": ["top_banner", "bottom_banner", "legal_notice"],
      "triggers": ["high_level", "strategic", "risk_of_disclosure"]
    },
    "B": {
      "name": "Confidential",
      "signals": ["single_marker"],
      "triggers": ["internal_sensitive"]
    },
    "C": {
      "name": "Unclassified Sensitive",
      "signals": ["minimal_marker"],
      "triggers": ["operational_low_risk"]
    },
    "D": {
      "name": "Non-Sensitive",
      "signals": ["explicit_public_marker"],
      "triggers": ["public", "open_distribution"]
    }
  },

  "governance_requirements": {
    "documentation": "All elements must be documented",
    "justification": "Deviations require rationale",
    "placement": "Classification marker must appear at top",
    "compatibility": "Must align with security conventions",
    "corpus_integrity": "Consistency across all documents"
  },

  "tagging": {
    "required": true,
    "consistent_across": ["header", "metadata", "changelog"],
    "examples": ["1.0.0-alpha", "1.0.0-rc.1"]
  },

  "integrity_rules": {
    "invalid_if": [
      "missing_classification_marker",
      "missing_required_metadata",
      "non_professional_fonts",
      "missing_banners_for_class_A",
      "missing_confidentiality_notice_for_A/B/C",
      "contradicts_roadmap"
    ]
  },

  "roadmap_governance": {
    "required": true,
    "version_controlled": true,
    "deviation_requires": "justification",
    "invalid_if_contradiction": true
  },

  "corpus_change_protocol": {
    "requires_justification": true,
    "major_change_if_boundary_shift": true,
    "independent_versioning": true,
    "integrity_preserved": true
  },

  "state_machine": {
    "allowed": ["Draft→Stable", "Stable→Deprecated"],
    "forbidden": ["Deprecated→Stable"],
    "preconditions": {
      "A": "security_markings_validated",
      "B": "internal_circulation_confirmed",
      "C": "sensitivity_assessed",
      "D": "public_status_confirmed"
    }
  },

  "compliance": {
    "supports": [
      "traceability",
      "auditability",
      "deterministic_evolution",
      "governance_alignment"
    ]
  },

  "document_control": {
    "owner": "Governance Authority",
    "change_authority": "Standards Board",
    "review_cycle": "per_major_change"
  },

  "changelog": {
    "entries": []
  }
}
